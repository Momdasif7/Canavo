{
  "name": "canavo",
  "private": true,
  "description": "CANAVO (Canteen Avatar Order) — POS + business management for Indian canteens",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@canavo/api --filter=@canavo/web",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "npm run prisma:migrate -w @canavo/api",
    "db:seed": "npm run seed -w @canavo/api",
    "security:secrets": "sh scripts/security/secrets.sh",
    "security:sast": "sh scripts/security/sast.sh",
    "test:smoke-pack": "node scripts/qa/regression.mjs smoke",
    "test:critical": "node scripts/qa/regression.mjs critical",
    "test:regression": "node scripts/qa/regression.mjs regression"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.6.3"
  },
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
