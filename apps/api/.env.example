# --- Core ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://canavo:canavo@localhost:5433/canavo?schema=public
# Comma-separated origins allowed to call the API (web app, Expo dev)
CORS_ORIGINS=http://localhost:3000
# Public base URL of this API, used for receipt links shared on WhatsApp
PUBLIC_API_URL=http://localhost:4000

# --- Auth --- (generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
RECEIPT_LINK_SECRET=change-me-receipt-secret-at-least-32-chars

# --- SMS OTP (MSG91). Leave blank in dev: OTP is logged and returned as devCode ---
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# --- Razorpay UPI QR. Leave blank to use mock mode (plain UPI intent QR + /dev/simulate) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional: Razorpay API base (default https://api.razorpay.com)
# RAZORPAY_BASE_URL=

# --- WhatsApp (WATI). Leave blank to fall back to a wa.me click-to-chat link ---
WATI_API_URL=
WATI_API_TOKEN=
WATI_RECEIPT_TEMPLATE=receipt_share

# --- SMS alerts (MSG91 flow API; template with a ##message## variable). Blank = logged only ---
MSG91_ALERT_TEMPLATE_ID=

# --- Email for scheduled reports (SMTP). Blank SMTP_HOST = emails are written to storage/outbox/ ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CANAVO Reports <reports@canavo.local>

# --- Image uploads (Cloudinary). Blank = files stored under storage/uploads/ and served by the API ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=canavo

# --- Expo push notifications (optional access token for "enhanced security" projects) ---
EXPO_ACCESS_TOKEN=

# --- PII encryption (Aadhaar). 32 bytes as 64 hex chars or base64: openssl rand -hex 32
# Required in production; in development a key is derived from JWT_ACCESS_SECRET (with a warning).
DATA_ENCRYPTION_KEY=

# --- Local storage root for uploads / backups / outbox (default: apps/api/storage) ---
STORAGE_DIR=
# Number of automatic daily backups to keep
BACKUP_RETENTION=14

# --- Phase 1 infrastructure (all optional locally) ---
# "embedded" runs jobs inside the API; "worker" expects `npm run worker -w @canavo/api` in another terminal
JOBS_MODE=embedded
REDIS_URL=
LOG_FORMAT=pretty
LOG_LEVEL=info
METRICS_TOKEN=
# Off-site backup copies: S3-compatible bucket, or a directory
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_OFFSITE_DIR=
