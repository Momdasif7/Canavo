{
  "name": "@canavo/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "prisma generate && tsc -p tsconfig.lint.json",
    "test": "vitest run",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "postinstall": "prisma generate",
    "test:smoke": "vitest run -c vitest.smoke.config.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "lint": "eslint --max-warnings=-1 src test prisma"
  },
  "dependencies": {
    "@canavo/shared": "*",
    "@prisma/client": "6.19.3",
    "archiver": "^5.3.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "pdfkit": "^0.17.2",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/archiver": "^5.3.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.2",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^8.57.1",
    "eslint-plugin-regexp": "^2.10.0",
    "fast-check": "^4.3.0",
    "prisma": "6.19.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.0",
    "vitest": "^3.2.4"
  }
}
