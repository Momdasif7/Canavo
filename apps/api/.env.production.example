# Render → canavo-api → Environment. Never commit real values.
NODE_ENV=production
PORT=4000
# Render Postgres "Internal Database URL" (or Neon/Supabase/RDS; add ?sslmode=require for external hosts)
DATABASE_URL=postgresql://canavo:CHANGE_ME@dpg-xxxxx-a/canavo
# Frontend origins allowed by the browser (Vercel domain + previews)
CORS_ORIGINS=https://app.example.in,https://*.vercel.app
# This API's public URL (used in receipt links and image URLs)
PUBLIC_API_URL=https://canavo-api.onrender.com
TRUST_PROXY=loopback, linklocal, uniquelocal
# openssl rand -hex 32  (each ≥ 32 chars)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
RECEIPT_LINK_SECRET=
# openssl rand -base64 32 — REQUIRED in production; back it up (encrypted Aadhaar / WhatsApp tokens need it)
DATA_ENCRYPTION_KEY=
# Optional: image hosting (recommended in production; otherwise images live on the Render disk)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: SMS/OTP, UPI QR, email, push (each falls back safely when empty)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CANAVO Reports <reports@example.in>
EXPO_ACCESS_TOKEN=
# WhatsApp keys are set per hotel in the app (Settings → WhatsApp); these are only a server-wide WATI fallback
WATI_API_URL=
WATI_API_TOKEN=
