# Render → canavo-api → Environment. Never commit real values.
NODE_ENV=production
PORT=4000
# Render Postgres "Internal Database URL" (or Neon/Supabase/RDS; add ?sslmode=require for external hosts)
DATABASE_URL=postgresql://canavo:CHANGE_ME@dpg-xxxxx-a/canavo
# Frontend origins allowed by the browser (Vercel domain + previews)
CORS_ORIGINS=https://app.example.in,https://*.vercel.app
# This API's public URL (used in receipt links and image URLs)
PUBLIC_API_URL=https://canavo-api.onrender.com
# Web app URL: password setup / reset links point here (required in production)
WEB_APP_URL=https://app.example.in
# Optional: ".example.in" when the web app and API share a domain (app. + api.): web sessions move to httpOnly cookies
AUTH_COOKIE_DOMAIN=
TRUST_PROXY=loopback, linklocal, uniquelocal
# openssl rand -hex 32  (each ≥ 32 chars)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
RECEIPT_LINK_SECRET=
# openssl rand -base64 32 — REQUIRED in production; back it up (encrypted Aadhaar / WhatsApp tokens need it)
DATA_ENCRYPTION_KEY=
# Optional: image hosting (recommended in production; otherwise images live on the Render disk)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Email (SMTP_*) or SMS (MSG91_AUTH_KEY + MSG91_ALERT_TEMPLATE_ID) is REQUIRED in production: password links go through it.
# The rest is optional: UPI QR, push (each falls back safely when empty)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# DLT template with a ##message## variable (alerts, password links by SMS)
MSG91_ALERT_TEMPLATE_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CANAVO Reports <reports@example.in>
EXPO_ACCESS_TOKEN=
# WhatsApp keys are set per hotel in the app (Settings → WhatsApp); these are only a server-wide WATI fallback
WATI_API_URL=
WATI_API_TOKEN=

# Background jobs: "worker" when the canavo-worker service runs them (node dist/worker.js); "embedded" = inside the API
JOBS_MODE=worker
# Only when running 2+ API instances (Socket.io rooms shared through Redis)
REDIS_URL=
# Logs: json in production; level fatal|error|warn|info|debug
LOG_FORMAT=json
LOG_LEVEL=info
# Bearer token for GET /metrics (16+ chars; /metrics is closed in production without it)
METRICS_TOKEN=

# Off-site backup copies (S3 / Cloudflare R2 / Backblaze B2 / MinIO). Set on the API and the worker.
BACKUP_RETENTION=14
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=ap-south-1
# R2 / B2 / MinIO endpoint, e.g. https://<account>.r2.cloudflarestorage.com (leave empty for AWS)
BACKUP_S3_ENDPOINT=
BACKUP_S3_PREFIX=canavo-backups/
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Or a mounted directory instead of S3
BACKUP_OFFSITE_DIR=
