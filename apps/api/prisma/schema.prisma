// CANAVO — Phase 1 schema. All money columns are integer paise.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  BUSINESS_OWNER
  OUTLET_MANAGER
  CASHIER
  KITCHEN
  DELIVERY
  INVENTORY_MANAGER
  WAITER
  ACCOUNTANT
  AUDITOR
  PLATFORM_SUPPORT
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SalaryType {
  DAILY
  MONTHLY
}

model Outlet {
  id                      String   @id @default(cuid())
  businessId              String
  name                    String
  address                 String   @default("")
  stateCode               String
  gstin                   String?
  /// Registered legal name printed on tax invoices
  legalName               String?
  /// false = not GST registered: plain bills with no tax lines
  gstEnabled              Boolean  @default(true)
  fssai                   String?
  phone                   String?
  logoUrl                 String?
  latitude                Float?
  longitude               Float?
  geofenceMeters          Int      @default(150)
  timezone                String   @default("Asia/Kolkata")
  invoicePrefix           String   @default("INV")
  pricesIncludeTax        Boolean  @default(true)
  compositionScheme       Boolean  @default(false)
  serviceChargeEnabled    Boolean  @default(false)
  serviceChargePercent    Float    @default(0)
  roundOff                Boolean  @default(true)
  upiVpa                  String?
  deliveryEnabled         Boolean  @default(false)
  /// Flat packaging charge per takeaway/delivery order, paise
  packagingCharge         Int      @default(0)
  /// Most orders a delivery partner can hold at once (auto-assign respects it)
  maxDeliveriesPerPartner Int      @default(2)
  /// POS item cards show menu photos (switch off for faster, text-only cards)
  posShowImages           Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  staff                   UserOutlet[]
  orders                  Order[]
  attendance              StaffAttendance[]
  invoiceCounter          InvoiceCounter[]
  itemOverrides           OutletItemOverride[]
  shifts                  Shift[]
  business                Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// D1 (Phase 3.6): flat ₹ discounts are GST-inclusive (false = pre-tax, the default)
  flatDiscountsIncludeTax Boolean              @default(false)
  /// Phase 3.3 (APPROVAL_PINS): a manual discount above this % of the bill needs a manager PIN
  approvalDiscountPercent Int                  @default(10)
  approvals               ApprovalLog[]
  creditNotes             CreditNote[]
  cashShifts              CashShift[]
  mealSlots               MealSlot[]
  /// Phase 6.4: address of the public online ordering page (/o/<slug>)
  publicSlug              String?              @unique
  /// Phase 6.3/6.4: QR ordering and online ordering settings (see storefrontSettingsSchema)
  storefront              Json                 @default("{}")
  channelRequests         ChannelRequest[]
  customerOtps            CustomerOtp[]
  channelConnections      ChannelConnection[]
  channelItemMaps         ChannelItemMap[]
  channelOrders           ChannelOrder[]
  orderHandovers          OrderHandover[]

  @@index([businessId])
}

model User {
  id                    String      @id @default(cuid())
  businessId            String?
  name                  String
  phone                 String      @unique
  email                 String?     @unique
  passwordHash          String?
  pinHash               String?
  role                  Role
  status                StaffStatus @default(ACTIVE)
  photoUrl              String?
  salaryType            SalaryType  @default(MONTHLY)
  /// Paise per day (DAILY) or per month (MONTHLY)
  salaryAmount          Int         @default(0)
  shiftId               String?
  /// Incremented on role change / suspension to force logout of all sessions
  tokenVersion          Int         @default(0)
  failedLogins          Int         @default(0)
  lockedUntil           DateTime?
  /// Clock-in PIN lockout (Phase 2.6): 5 wrong PINs lock clock-in for 15 minutes
  pinFailedAttempts     Int         @default(0)
  pinLockedUntil        DateTime?
  /// AES-256-GCM encrypted full Aadhaar number (only when the hotel keeps full numbers: aadhaarMode FULL)
  aadhaarEnc            String?
  /// Last 4 digits of the Aadhaar (Phase 2.5: the default; enough to identify a staff record)
  aadhaarLast4          String?
  /// Consent record: when, recorded by whom, and which consent text the staff member agreed to
  aadhaarConsentAt      DateTime?
  aadhaarConsentById    String?
  aadhaarConsentVersion String?
  /// Two-factor login (Phase 2.1): encrypted TOTP secret; enabled once confirmed with a code
  totpSecretEnc         String?
  totpEnabledAt         DateTime?
  /// Last accepted 30-second step (a code can't be used twice)
  totpLastStep          Int?
  /// Delivery partners: at the outlet (can take orders) vs out on a delivery run
  deliveryAtOutlet      Boolean     @default(true)
  deliveryRunStartedAt  DateTime?
  /// Last GPS fix sent by the partner app while on duty
  lastLat               Float?
  lastLng               Float?
  lastLocationAt        DateTime?
  /// Custom role (Phase 4.2): narrows the base `role`'s permissions; null = the full base role
  customRoleId          String?
  /// Own appearance (light/dark, text size, density, personal accent) — see userPreferencesSchema in @canavo/shared
  preferences           Json        @default("{}")
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  customRole     CustomRole?          @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  shift          Shift?               @relation(fields: [shiftId], references: [id])
  outlets        UserOutlet[]
  refreshTokens  RefreshToken[]
  passwordTokens PasswordResetToken[]
  recoveryCodes  RecoveryCode[]
  attendance     StaffAttendance[]
  leaves         LeaveRequest[]       @relation("leaveApplicant")
  leaveReviews   LeaveRequest[]       @relation("leaveReviewer")
  orders         Order[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  waiterTables   DiningTable[]        @relation("tableWaiter")
  waiterSessions TableSession[]       @relation("sessionWaiter")
  deliveries     Delivery[]           @relation("deliveryAgent")
  deviceTokens   DeviceToken[]
  business       Business?            @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model UserOutlet {
  userId   String
  outletId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  outlet   Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@id([userId, outletId])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  /// All tokens descended from one login share a family; reuse of a rotated token revokes the family
  familyId   String
  deviceId   String?
  /// Where the session started (shown in "Signed-in devices")
  ip         String?
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId, revokedAt])
}

enum PasswordTokenPurpose {
  RESET
  INVITE
}

/// One-time link to set a password (Phase 2.2). Only the hash is stored; the platform never sees the password.
model PasswordResetToken {
  id          String               @id @default(cuid())
  userId      String
  tokenHash   String               @unique
  purpose     PasswordTokenPurpose @default(RESET)
  expiresAt   DateTime
  usedAt      DateTime?
  /// Who asked for it: null = the user (forgot password); otherwise the admin/owner who sent it
  requestedBy String?
  createdAt   DateTime             @default(now())
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

// ---------- Attendance ----------

model Shift {
  id           String @id @default(cuid())
  outletId     String
  name         String
  /// "HH:MM" in outlet timezone
  startTime    String
  endTime      String
  graceMinutes Int    @default(10)
  outlet       Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)
  users        User[]
}

enum AttendanceStatus {
  PRESENT
  HALF_DAY
  ABSENT
  LEAVE
}

model StaffAttendance {
  id               String           @id @default(cuid())
  userId           String
  outletId         String
  /// Local calendar date (YYYY-MM-DD) in outlet timezone
  workDate         String
  clockInAt        DateTime
  clockOutAt       DateTime?
  clockInLat       Float?
  clockInLng       Float?
  clockInDistance  Int
  /// GPS accuracy (m) reported by the phone at clock-in
  clockInAccuracy  Int?
  /// The phone reported a fake (mock) location at clock-in
  clockInMocked    Boolean          @default(false)
  /// Selfie taken at clock-in (feature CLOCK_IN_SELFIE); stored for the manager to review, no face matching
  clockInSelfieUrl String?
  /// Things the manager should look at: MOCK_LOCATION, LOW_ACCURACY, NO_ACCURACY
  clockInFlags     String[]         @default([])
  clockOutLat      Float?
  clockOutLng      Float?
  workedMinutes    Int?
  overtimeMinutes  Int              @default(0)
  lateByMinutes    Int              @default(0)
  earlyByMinutes   Int              @default(0)
  status           AttendanceStatus @default(PRESENT)
  /// SELF = clocked in by the employee (GPS); MANUAL = added / corrected by a manager or owner
  source           String           @default("SELF")
  note             String?
  /// Manager / owner who added or last edited this record
  markedById       String?
  editedAt         DateTime?
  createdAt        DateTime         @default(now())
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  outlet           Outlet           @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([userId, workDate])
  @@index([outletId, workDate])
}

enum LeaveType {
  CASUAL
  SICK
  UNPAID
  HALF_DAY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id         String      @id @default(cuid())
  userId     String
  fromDate   String
  toDate     String
  type       LeaveType
  reason     String      @default("")
  status     LeaveStatus @default(PENDING)
  reviewerId String?
  reviewedAt DateTime?
  createdAt  DateTime    @default(now())
  user       User        @relation("leaveApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewer   User?       @relation("leaveReviewer", fields: [reviewerId], references: [id])
}

// ---------- Menu ----------

enum FoodType {
  VEG
  NON_VEG
  EGG
}

enum ItemStatus {
  AVAILABLE
  OUT_OF_STOCK
  HIDDEN
}

model MenuCategory {
  id         String         @id @default(cuid())
  businessId String
  name       String
  parentId   String?
  sortOrder  Int            @default(0)
  parent     MenuCategory?  @relation("subcategories", fields: [parentId], references: [id])
  children   MenuCategory[] @relation("subcategories")
  items      MenuItem[]
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model MenuItem {
  id                String               @id @default(cuid())
  businessId        String
  name              String
  description       String               @default("")
  categoryId        String
  /// Base price in paise
  price             Int
  foodType          FoodType             @default(VEG)
  gstRate           Float                @default(0)
  /// Custom tax rate (CGST/SGST/IGST/cess); falls back to gstRate split equally
  taxRateId         String?
  hsnCode           String               @default("996331")
  imageUrl          String?
  status            ItemStatus           @default(AVAILABLE)
  allergens         String[]
  availableFrom     String?
  availableTo       String?
  kitchenStation    String               @default("MAIN")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  category          MenuCategory         @relation(fields: [categoryId], references: [id])
  variants          ItemVariant[]
  addons            ItemAddon[]
  overrides         OutletItemOverride[]
  orderItems        OrderItem[]
  recipes           Recipe[]
  mealSlotItems     MealSlotItem[]
  mealSubscriptions MealSubscription[]
  taxRate           TaxRate?             @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  business          Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model ItemVariant {
  id         String   @id @default(cuid())
  menuItemId String
  name       String
  price      Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
}

model ItemAddon {
  id         String   @id @default(cuid())
  menuItemId String
  name       String
  price      Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
}

model OutletItemOverride {
  outletId           String
  menuItemId         String
  price              Int?
  status             ItemStatus?
  /// Set automatically when an ingredient at this outlet can't cover one portion; cleared when restocked.
  stockOut           Boolean     @default(false)
  /// Sizes that are out of stock while other sizes can still be sold
  stockOutVariantIds String[]    @default([])
  /// Ingredient names that ran out (shown to staff)
  stockOutReason     String?
  outlet             Outlet      @relation(fields: [outletId], references: [id], onDelete: Cascade)
  menuItem           MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@id([outletId, menuItemId])
}

// ---------- Orders, KOT, payments ----------

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
  PRE_ORDER
}

enum OrderStatus {
  OPEN
  PAID
  CANCELLED
}

enum DocumentType {
  TAX_INVOICE
  BILL_OF_SUPPLY
  /// GST not registered / disabled: plain bill, no tax
  BILL
}

model InvoiceCounter {
  outletId String
  fyStart  Int
  lastSeq  Int    @default(0)
  outlet   Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@id([outletId, fyStart])
}

model Order {
  id             String         @id @default(cuid())
  clientOrderId  String?        @unique
  outletId       String
  cashierId      String
  invoiceNumber  String
  documentType   DocumentType
  orderType      OrderType
  status         OrderStatus    @default(OPEN)
  tableLabel     String?
  customerName   String?
  customerPhone  String?
  interState     Boolean        @default(false)
  notes          String?
  subtotal       Int
  discount       Int
  taxableValue   Int
  serviceCharge  Int
  cgst           Int
  sgst           Int
  igst           Int
  cess           Int            @default(0)
  /// Other taxes (e.g. VAT), paise
  otherTaxes     Int            @default(0)
  /// [{ label, percent, amount }] per extra tax
  taxDetails     Json           @default("[]")
  roundOff       Int
  grandTotal     Int
  taxBreakup     Json
  paidAt         DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  syncedOffline  Boolean        @default(false)
  customerId     String?
  /// Pre-orders: when the customer wants the food
  scheduledFor   DateTime?
  tableSessionId String?
  /// Promotions, coupon and loyalty redemption (pre-tax value), paise
  promoDiscount  Int            @default(0)
  couponCode     String?
  pointsRedeemed Int            @default(0)
  /// [{ kind, id?, label, amount }]
  appliedOffers  Json           @default("[]")
  /// Delivery fee, packaging etc. (pre-tax), paise
  extraCharges   Int            @default(0)
  /// [{ label, amount }]
  chargesBreakup Json           @default("[]")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  customer       Customer?      @relation(fields: [customerId], references: [id])
  tableSession   TableSession?  @relation(fields: [tableSessionId], references: [id])
  delivery       Delivery?
  /// Phase 6: packing / handover of an online-channel order (Online orders board)
  handover       OrderHandover?
  outlet         Outlet         @relation(fields: [outletId], references: [id])
  cashier        User           @relation(fields: [cashierId], references: [id])
  items          OrderItem[]
  kots           KotTicket[]
  payments       Payment[]
  /// Total of credit notes issued against this bill (Phase 3.1), paise
  refundedAmount Int            @default(0)
  creditNotes    CreditNote[]
  /// Phase 5 (CANTEEN): meal slot the bill belongs to (counter bills: the slot open at billing time; pre-orders: the chosen slot)
  mealSlotId     String?
  /// Phase 5.3 (CANTEEN): pre-order handed over at the counter (redeemed)
  servedAt       DateTime?
  /// Phase 6: where the order came from (POS, QR, ONLINE, ZOMATO, SWIGGY, ONDC, OTHER)
  channel        String         @default("POS")
  /// The channel's own order id (aggregators / hub); unique per outlet and channel
  channelOrderId String?

  @@unique([outletId, invoiceNumber])
  @@unique([outletId, channel, channelOrderId])
  @@index([outletId, createdAt])
  @@index([outletId, channel, createdAt])
  @@index([customerId])
  @@index([outletId, status, createdAt])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  menuItemId    String
  variantId     String?
  /// Snapshot of name incl. variant + add-ons at time of sale
  name          String
  variantName   String?
  addons        Json     @default("[]")
  quantity      Int
  unitPrice     Int
  gstRate       Float
  hsnCode       String
  discount      Int
  taxableValue  Int
  serviceCharge Int
  cgst          Int
  sgst          Int
  igst          Int
  cess          Int      @default(0)
  otherTaxes    Int      @default(0)
  /// Rates applied: { name, cgst, sgst, igst, cess, extras[] }
  taxRates      Json     @default("{}")
  total         Int
  notes         String?
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@index([menuItemId])
}

enum KotStatus {
  RECEIVED
  PREPARING
  READY
  SERVED
}

model KotTicket {
  id          String        @id @default(cuid())
  /// Set for KOTs fired from a bill; null for running dine-in tabs until billed
  orderId     String?
  /// Dine-in running tab this KOT belongs to
  sessionId   String?
  /// Pre-orders: hidden from the kitchen until this time
  releaseAt   DateTime?
  outletId    String
  kotNumber   Int
  station     String
  status      KotStatus     @default(RECEIVED)
  /// [{ name, quantity, notes }]
  items       Json
  printedAt   DateTime?
  /// When the kitchen started / finished / served it (bill detail shows the food's progress)
  preparingAt DateTime?
  readyAt     DateTime?
  servedAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  order       Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  session     TableSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([outletId, status])
  @@index([orderId])
  @@index([sessionId])
  @@index([outletId, createdAt])
}

enum PaymentMode {
  CASH
  UPI
  CARD
  KHATA
  /// Phase 3.8: closed-loop gift card (feature GIFT_CARDS)
  GIFT_CARD
  /// Phase 5.1 (CANTEEN): employer's share of a member's meal, billed to the company monthly
  CORPORATE
  /// Phase 5.2 (CANTEEN): member's prepaid wallet
  WALLET
  /// Phase 5.2 (CANTEEN): prepaid meal token(s)
  MEAL_TOKEN
  /// Phase 6.1: paid online / collected by the channel (aggregator, online ordering page)
  ONLINE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model Payment {
  id                 String        @id @default(cuid())
  orderId            String
  mode               PaymentMode
  amount             Int
  status             PaymentStatus @default(SUCCESS)
  reference          String?
  /// Razorpay QR code id for UPI QR payments
  gatewayRef         String?       @unique
  qrPayload          String?
  createdAt          DateTime      @default(now())
  confirmedAt        DateTime?
  /// Who received the money (e.g. the delivery partner at the door); null = outlet counter
  collectedById      String?
  /// Phase 3.8: tip on top of this payment (not part of the bill, not taxed), paise
  tip                Int           @default(0)
  /// Card payments: last 4 digits and the terminal's approval code
  cardLast4          String?
  authCode           String?
  /// Gift card used (mode GIFT_CARD)
  giftCardId         String?
  /// Card / UPI: matched to the acquirer's or bank's settlement
  settledAt          DateTime?
  settlementRef      String?
  /// Phase 5.1: company billed for this share (mode CORPORATE)
  corporateAccountId String?
  /// Phase 5.2: meal tokens used (mode MEAL_TOKEN)
  tokens             Int?
  order              Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([collectedById])
  @@index([orderId])
  @@index([corporateAccountId, createdAt])
}

// ---------- Audit & notifications ----------

model AuditLog {
  id         String   @id @default(cuid())
  businessId String?
  userId     String?
  outletId   String?
  action     String
  entity     String
  entityId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([outletId, createdAt])
  @@index([businessId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  kind      String
  /// Screen to open when tapped (web route, e.g. /delivery); mobile maps it to its own screens
  link      String?
  outletId  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

// =====================================================================
// Phase 2–3
// =====================================================================

/// Key-value settings. scope = "GLOBAL" or an outlet id.
model Setting {
  scope     String
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@id([scope, key])
}

// ---------- Tables, running tabs, reservations ----------

enum TableStatus {
  AVAILABLE
  OCCUPIED
  NEEDS_ATTENTION
  RESERVED
}

enum TableShape {
  SQUARE
  ROUND
  RECTANGLE
}

model DiningArea {
  id        String        @id @default(cuid())
  outletId  String
  name      String
  sortOrder Int           @default(0)
  tables    DiningTable[]

  @@index([outletId])
}

model DiningTable {
  id           String         @id @default(cuid())
  outletId     String
  areaId       String?
  label        String
  capacity     Int            @default(4)
  shape        TableShape     @default(SQUARE)
  /// Floor-plan position/size in grid units
  posX         Int            @default(0)
  posY         Int            @default(0)
  width        Int            @default(2)
  height       Int            @default(2)
  rotation     Int            @default(0)
  status       TableStatus    @default(AVAILABLE)
  waiterId     String?
  active       Boolean        @default(true)
  /// Phase 6.3: unguessable token in the table's QR code (/t/<token>); rotating it kills printed codes
  qrToken      String?        @unique
  area         DiningArea?    @relation(fields: [areaId], references: [id], onDelete: SetNull)
  waiter       User?          @relation("tableWaiter", fields: [waiterId], references: [id], onDelete: SetNull)
  sessions     TableSession[]
  reservations Reservation[]

  @@unique([outletId, label])
}

enum SessionStatus {
  OPEN
  CLOSED
}

/// A running dine-in tab: KOTs are fired per round, the bill is raised at the end.
model TableSession {
  id             String             @id @default(cuid())
  outletId       String
  tableId        String
  /// Tables merged into this session (labels shown on KOT/bill)
  mergedTableIds String[]
  status         SessionStatus      @default(OPEN)
  guests         Int                @default(1)
  waiterId       String?
  customerName   String?
  customerPhone  String?
  openedAt       DateTime           @default(now())
  closedAt       DateTime?
  table          DiningTable        @relation(fields: [tableId], references: [id])
  waiter         User?              @relation("sessionWaiter", fields: [waiterId], references: [id], onDelete: SetNull)
  items          TableSessionItem[]
  kots           KotTicket[]
  orders         Order[]

  @@index([outletId, status])
}

model TableSessionItem {
  id            String       @id @default(cuid())
  sessionId     String
  menuItemId    String
  variantId     String?
  addonIds      String[]
  quantity      Int
  notes         String?
  /// Seat number, for split-by-seat
  seat          Int?
  kotId         String?
  /// Set once this item is included in a bill
  billedOrderId String?
  createdAt     DateTime     @default(now())
  session       TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

enum ReservationStatus {
  BOOKED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Reservation {
  id            String            @id @default(cuid())
  outletId      String
  tableId       String?
  customerName  String
  customerPhone String
  partySize     Int
  reservedFor   DateTime
  durationMin   Int               @default(90)
  status        ReservationStatus @default(BOOKED)
  notes         String?
  /// Pre-selected menu: [{ menuItemId, variantId?, addonIds, quantity, notes? }]
  preOrderItems Json              @default("[]")
  /// Advance paid, paise
  advancePaid   Int               @default(0)
  sessionId     String?
  createdById   String?
  createdAt     DateTime          @default(now())
  table         DiningTable?      @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([outletId, reservedFor])
}

// ---------- Delivery ----------

enum DeliveryStatus {
  PENDING
  ACCEPTED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model DeliveryZone {
  id         String  @id @default(cuid())
  outletId   String
  name       String
  radiusKm   Float
  /// Delivery fee, paise
  fee        Int     @default(0)
  minOrder   Int     @default(0)
  etaMinutes Int     @default(30)
  active     Boolean @default(true)

  @@index([outletId])
}

model Delivery {
  id                String         @id @default(cuid())
  orderId           String         @unique
  outletId          String
  agentId           String?
  status            DeliveryStatus @default(PENDING)
  source            String         @default("PHONE")
  /// Cash on Delivery: the delivery partner collects the bill amount in cash at the door
  cod               Boolean        @default(false)
  customerName      String
  customerPhone     String
  address           String
  landmark          String?
  latitude          Float?
  longitude         Float?
  distanceKm        Float?
  zoneId            String?
  etaAt             DateTime?
  /// When managers / the partner were told the delivery is running late (sent once)
  overdueNotifiedAt DateTime?
  assignedAt        DateTime?
  acceptedAt        DateTime?
  pickedAt          DateTime?
  deliveredAt       DateTime?
  /// Cash collected at the door handed over to the outlet
  cashSettledAt     DateTime?
  cashSettledById   String?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  agent             User?          @relation("deliveryAgent", fields: [agentId], references: [id], onDelete: SetNull)

  @@index([outletId, status])
  @@index([agentId, status])
  @@index([outletId, createdAt])
}

// ---------- Customers, loyalty, khata ----------

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

model Customer {
  id                 String               @id @default(cuid())
  businessId         String
  phone              String
  name               String?
  email              String?
  /// "MM-DD"
  birthday           String?
  anniversary        String?
  totalSpend         Int                  @default(0)
  visitCount         Int                  @default(0)
  lastVisitAt        DateTime?
  points             Int                  @default(0)
  tier               LoyaltyTier          @default(BRONZE)
  /// Outstanding khata (credit) balance, paise; positive = customer owes
  khataBalance       Int                  @default(0)
  khataLimit         Int                  @default(0)
  blocked            Boolean              @default(false)
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  /// Phase 5 (CANTEEN): a canteen member (employee / student) — card, wallet, company subsidy
  canteenMember      Boolean              @default(false)
  corporateAccountId String?
  employeeCode       String?
  department         String?
  /// RFID / QR card value (USB readers type it + Enter), unique per business
  cardUid            String?
  memberActive       Boolean              @default(true)
  /// Prepaid wallet balance, paise (liability: no GST until spent)
  walletBalance      Int                  @default(0)
  orders             Order[]
  loyaltyTxns        LoyaltyTransaction[]
  khataTxns          KhataTransaction[]
  walletTxns         WalletTxn[]
  mealTokens         MealTokenAccount[]
  corporateAccount   CorporateAccount?    @relation(fields: [corporateAccountId], references: [id], onDelete: SetNull)
  business           Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, phone])
  @@unique([businessId, cardUid])
  @@index([businessId])
  @@index([businessId, employeeCode])
  @@index([corporateAccountId])
}

enum LoyaltyTxnType {
  EARN
  REDEEM
  ADJUST
  EXPIRE
  REVERSE
}

model LoyaltyTransaction {
  id          String         @id @default(cuid())
  customerId  String
  orderId     String?
  type        LoyaltyTxnType
  points      Int
  note        String?
  createdById String?
  createdAt   DateTime       @default(now())
  customer    Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

enum KhataTxnType {
  DEBIT
  CREDIT
}

model KhataTransaction {
  id          String       @id @default(cuid())
  customerId  String
  outletId    String
  orderId     String?
  type        KhataTxnType
  amount      Int
  mode        String?
  note        String?
  createdById String?
  createdAt   DateTime     @default(now())
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

// ---------- Offers & coupons ----------

enum OfferType {
  COMBO
  HAPPY_HOUR
  BUY_X_GET_Y
  ITEM_DISCOUNT
  BILL_DISCOUNT
}

model Offer {
  id         String    @id @default(cuid())
  businessId String
  name       String
  type       OfferType
  active     Boolean   @default(true)
  /// Empty = all outlets
  outletIds  String[]
  startsAt   DateTime?
  endsAt     DateTime?
  /// 0 = Sunday … 6 = Saturday; empty = every day
  daysOfWeek Int[]
  /// "HH:MM" window in outlet time (happy hour)
  startTime  String?
  endTime    String?
  priority   Int       @default(0)
  /// Phase 3.7: applies on top of the best offer (default: one offer per bill)
  combinable Boolean   @default(false)
  /// Type-specific config, validated by the offers engine
  config     Json
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

enum DiscountType {
  FLAT
  PERCENT
}

model Coupon {
  id               String             @id @default(cuid())
  businessId       String
  code             String
  description      String             @default("")
  discountType     DiscountType
  /// Paise for FLAT, percent for PERCENT
  value            Int
  maxDiscount      Int?
  minOrder         Int                @default(0)
  usageLimit       Int?
  perCustomerLimit Int?
  usedCount        Int                @default(0)
  startsAt         DateTime?
  expiresAt        DateTime?
  active           Boolean            @default(true)
  /// Personal coupons (e.g. birthday) can only be used by this customer
  customerId       String?
  createdAt        DateTime           @default(now())
  redemptions      CouponRedemption[]
  business         Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, code])
  @@index([businessId])
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  orderId    String   @unique
  customerId String?
  amount     Int
  createdAt  DateTime @default(now())
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
}

// ---------- Inventory ----------

enum StockUnit {
  KG
  G
  L
  ML
  PIECE
  PACKET
  DOZEN
  BOX
}

model InventoryItem {
  id           String                 @id @default(cuid())
  businessId   String
  name         String
  sku          String?
  barcode      String?
  category     String                 @default("General")
  unit         StockUnit
  /// Latest/weighted average cost per unit, paise
  costPerUnit  Int                    @default(0)
  reorderLevel Float                  @default(0)
  reorderQty   Float                  @default(0)
  active       Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  stocks       InventoryStock[]
  transactions InventoryTransaction[]
  recipes      Recipe[]
  business     Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId])
}

model InventoryStock {
  outletId        String
  inventoryItemId String
  quantity        Float         @default(0)
  updatedAt       DateTime      @updatedAt
  item            InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@id([outletId, inventoryItemId])
}

enum InventoryTxnType {
  OPENING
  PURCHASE
  SALE
  SALE_REVERSAL
  WASTAGE
  ADJUSTMENT
  AUDIT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN
}

model InventoryTransaction {
  id              String           @id @default(cuid())
  outletId        String
  inventoryItemId String
  type            InventoryTxnType
  /// Signed quantity in the item's unit (+ in, − out)
  quantity        Float
  unitCost        Int?
  balanceAfter    Float
  refType         String?
  refId           String?
  note            String?
  createdById     String?
  createdAt       DateTime         @default(now())
  item            InventoryItem    @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([outletId, inventoryItemId, createdAt])
  @@index([refType, refId])
  @@index([outletId, createdAt])
}

/// Ingredient usage per sold unit of a menu item (optionally per variant).
model Recipe {
  id              String        @id @default(cuid())
  menuItemId      String
  /// null = applies to every variant without its own recipe
  variantId       String?
  inventoryItemId String
  /// In the inventory item's unit
  quantity        Float
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  item            InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId, variantId])
  @@index([inventoryItemId])
}

model Vendor {
  id            String     @id @default(cuid())
  businessId    String
  name          String
  contactPerson String?
  phone         String?
  email         String?
  gstin         String?
  address       String?
  notes         String?
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  purchases     Purchase[]
  business      Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

model Purchase {
  id              String            @id @default(cuid())
  outletId        String
  vendorId        String
  invoiceNo       String?
  invoiceDate     String?
  invoiceImageUrl String?
  status          PurchaseStatus    @default(DRAFT)
  subtotal        Int               @default(0)
  tax             Int               @default(0)
  total           Int               @default(0)
  paidAmount      Int               @default(0)
  notes           String?
  createdById     String?
  receivedAt      DateTime?
  createdAt       DateTime          @default(now())
  vendor          Vendor            @relation(fields: [vendorId], references: [id])
  items           PurchaseItem[]
  payments        PurchasePayment[]

  @@index([outletId, createdAt])
}

model PurchasePayment {
  id          String   @id @default(cuid())
  purchaseId  String
  amount      Int
  mode        String
  reference   String?
  createdById String?
  paidAt      DateTime @default(now())
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
}

model PurchaseItem {
  id              String   @id @default(cuid())
  purchaseId      String
  inventoryItemId String
  quantity        Float
  unitCost        Int
  taxRate         Float    @default(0)
  total           Int
  purchase        Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
}

enum AuditStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model StockAudit {
  id          String           @id @default(cuid())
  outletId    String
  status      AuditStatus      @default(IN_PROGRESS)
  notes       String?
  startedById String?
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  lines       StockAuditLine[]
}

model StockAuditLine {
  id              String     @id @default(cuid())
  auditId         String
  inventoryItemId String
  systemQty       Float
  countedQty      Float?
  audit           StockAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@unique([auditId, inventoryItemId])
}

enum TransferStatus {
  REQUESTED
  APPROVED
  DISPATCHED
  RECEIVED
  REJECTED
  CANCELLED
}

model StockTransfer {
  id            String              @id @default(cuid())
  fromOutletId  String
  toOutletId    String
  status        TransferStatus      @default(REQUESTED)
  notes         String?
  requestedById String?
  approvedById  String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  items         StockTransferItem[]
}

model StockTransferItem {
  id              String        @id @default(cuid())
  transferId      String
  inventoryItemId String
  quantity        Float
  transfer        StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
}

// ---------- Platform ----------

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReportSchedule {
  id         String    @id @default(cuid())
  outletId   String
  email      String
  frequency  String
  reports    String[]
  active     Boolean   @default(true)
  lastSentAt DateTime?
  createdAt  DateTime  @default(now())
}

// =====================================================================
// Multi-business (SaaS) + custom tax rates
// =====================================================================

enum BusinessStatus {
  ACTIVE
  SUSPENDED
}

/// A client business (hotel / restaurant / shop). All its data is isolated from other businesses.
model Business {
  id             String          @id @default(cuid())
  name           String
  legalName      String?
  ownerName      String?
  phone          String?
  email          String?
  status         BusinessStatus  @default(ACTIVE)
  /// Enabled feature modules (see MODULES in @canavo/shared)
  modules        String[]
  /// Per-hotel feature flags { FLAG: true } (see FEATURES in @canavo/shared); absent = off
  features       Json            @default("{}")
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  outlets        Outlet[]
  users          User[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  customers      Customer[]
  inventoryItems InventoryItem[]
  vendors        Vendor[]
  offers         Offer[]
  coupons        Coupon[]
  taxRates       TaxRate[]
  supportGrants  SupportGrant[]
  customRoles    CustomRole[]
  /// Staff Aadhaar storage (Phase 2.5): LAST4 = only the last 4 digits (default); FULL = full number, encrypted
  aadhaarMode    AadhaarMode     @default(LAST4)
  /// Brand look for everyone in the business { accent, corners } — see brandSchema in @canavo/shared
  brand          Json            @default("{}")
}

/// A tax rate a business defines for its menu (e.g. "GST 5%" = CGST 2.5 + SGST 2.5, or with cess / VAT).
model TaxRate {
  id         String     @id @default(cuid())
  businessId String
  name       String
  /// Percentages for intra-state supply
  cgst       Float      @default(0)
  sgst       Float      @default(0)
  /// Percentage for inter-state supply (normally cgst + sgst)
  igst       Float      @default(0)
  cess       Float      @default(0)
  /// Additional named taxes: [{ label, percent }]
  extras     Json       @default("[]")
  isDefault  Boolean    @default(false)
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  menuItems  MenuItem[]

  @@index([businessId])
}

/// Cash a delivery partner handed over to the outlet (entered manually by a manager / cashier).
/// Cash in hand = cash collected at the door − handovers.
model DeliveryCashHandover {
  id           String   @id @default(cuid())
  outletId     String
  agentId      String
  /// Paise
  amount       Int
  note         String?
  receivedById String
  /// When the cash was received (defaults to now; can be back-dated for corrections)
  receivedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([outletId, agentId, receivedAt])
}

/// Idempotency-Key replay store (Phase 1.4): one row per (user, key); response kept 24 h.
model IdempotencyKey {
  id             String   @id @default(cuid())
  userId         String
  key            String
  /// sha256 of method + path + body: the same key with a different request is refused
  requestHash    String
  method         String
  path           String
  /// null while the first request is still running
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([userId, key])
  @@index([expiresAt])
}

/// Transactional outbox (Phase 1.3): events written in the same transaction as the change,
/// delivered after commit by the API's publisher (socket emits, push, follow-up tasks), with retries.
model OutboxEvent {
  seq         BigInt    @id @default(autoincrement())
  /// Business the event belongs to (handlers run in its tenant context); null = platform
  businessId  String?
  /// socket.outlet | socket.user | task
  kind        String
  /// outletId / userId for socket kinds
  target      String?
  /// socket event name, or task name
  name        String
  payload     Json
  attempts    Int       @default(0)
  /// Not before this time (also the claim lease while a publisher works on it)
  availableAt DateTime  @default(now())
  deliveredAt DateTime?
  /// Gave up after max attempts (dead letter, kept for inspection)
  failedAt    DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([deliveredAt, failedAt, availableAt])
}

/// Single-use 2FA recovery codes (Phase 2.1); only hashes are stored.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Owner-consented, time-limited, read-only support access for the platform team (Phase 2.4).
model SupportGrant {
  id          String    @id @default(cuid())
  businessId  String
  /// The owner who granted it
  grantedById String
  reason      String?
  expiresAt   DateTime
  revokedAt   DateTime?
  revokedById String?
  createdAt   DateTime  @default(now())
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, expiresAt])
}

enum AadhaarMode {
  LAST4
  FULL
}

enum ApprovalAction {
  DISCOUNT
  VOID
  REFUND
  CASH_PAYOUT
}

/// Who approved what at the counter (Phase 3.3); feeds the exceptions report.
model ApprovalLog {
  id            String         @id @default(cuid())
  outletId      String
  action        ApprovalAction
  orderId       String?
  requestedById String
  /// Same as requestedById when a manager/owner did it themselves; null = offline (couldn't be approved)
  approvedById  String?
  /// Amount concerned (discount, refund, void total), paise
  amount        Int            @default(0)
  reason        String?
  createdAt     DateTime       @default(now())
  outlet        Outlet         @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([outletId, createdAt])
  @@index([orderId])
}

enum RefundReason {
  WRONG_ITEM
  QUALITY
  NOT_DELIVERED
  OVERCHARGED
  CUSTOMER_CHANGED_MIND
  OTHER
}

/// Credit note (refund) against a paid bill (Phase 3.1). Its own series per outlet and FY.
model CreditNote {
  id           String       @id @default(cuid())
  outletId     String
  orderId      String
  /// e.g. "CN/26-27/0007"
  number       String
  fyStart      Int
  reason       RefundReason
  note         String?
  /// How the money went back: CASH / UPI / CARD (KHATA = reduces the customer's credit)
  refundMode   PaymentMode
  /// Refunded lines: [{ orderItemId, name, quantity, taxableValue, cgst, sgst, igst, cess, otherTaxes, total }]; empty = value-only credit
  items        Json         @default("[]")
  taxableValue Int
  cgst         Int
  sgst         Int
  igst         Int
  cess         Int          @default(0)
  otherTaxes   Int          @default(0)
  /// Total refunded (incl. tax), paise
  amount       Int
  restocked    Boolean      @default(false)
  createdById  String
  approvedById String?
  createdAt    DateTime     @default(now())
  outlet       Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([outletId, number])
  @@index([outletId, createdAt])
  @@index([orderId])
}

/// Credit note numbers per outlet and financial year.
model CreditNoteCounter {
  outletId String
  fyStart  Int
  lastSeq  Int    @default(0)

  @@id([outletId, fyStart])
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

/// Cash drawer shift (Phase 3.2): opening float → sales, pay-ins/outs, refunds → counted cash; Z-report on close.
model CashShift {
  id            String          @id @default(cuid())
  outletId      String
  status        CashShiftStatus @default(OPEN)
  openedById    String
  openedAt      DateTime        @default(now())
  openingFloat  Int
  closedById    String?
  closedAt      DateTime?
  /// What the cashier counted at close, paise
  countedCash   Int?
  /// What should be in the drawer at close, paise
  expectedCash  Int?
  /// counted − expected (negative = short), paise
  variance      Int?
  /// { "500": 3, "100": 7, ... } notes and coins counted (optional)
  denominations Json?
  note          String?
  /// Z-report figures frozen at close
  summary       Json?
  outlet        Outlet          @relation(fields: [outletId], references: [id], onDelete: Cascade)
  movements     CashMovement[]

  @@index([outletId, openedAt])
  @@index([outletId, status])
}

enum CashMovementType {
  PAY_IN
  PAY_OUT
}

/// Cash put into or taken out of the drawer without a sale (change, supplier paid in cash, etc.)
model CashMovement {
  id           String           @id @default(cuid())
  shiftId      String
  outletId     String
  type         CashMovementType
  amount       Int
  reason       String
  createdById  String
  approvedById String?
  createdAt    DateTime         @default(now())
  shift        CashShift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
}

/// Closed-loop gift card (Phase 3.8, D6): usable only at this business, no cash-out.
model GiftCard {
  id            String        @id @default(cuid())
  businessId    String
  /// Printed / shared code, unique per business
  code          String
  initialValue  Int
  balance       Int
  /// How it was paid for when sold (CASH / UPI / CARD) — no GST at sale; GST applies when it's spent
  soldMode      String?
  soldOutletId  String?
  customerName  String?
  customerPhone String?
  expiresAt     DateTime?
  active        Boolean       @default(true)
  createdById   String
  createdAt     DateTime      @default(now())
  transactions  GiftCardTxn[]

  @@unique([businessId, code])
}

enum GiftCardTxnType {
  ISSUE
  REDEEM
  REFUND
  ADJUST
}

model GiftCardTxn {
  id          String          @id @default(cuid())
  giftCardId  String
  outletId    String?
  type        GiftCardTxnType
  /// Signed: + adds to the balance, − spends
  amount      Int
  orderId     String?
  note        String?
  createdById String?
  createdAt   DateTime        @default(now())
  giftCard    GiftCard        @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  @@index([giftCardId])
}

/// Offline invoice series of one billing device at an outlet (Phase 3.4, OFFLINE_INVOICE_SERIES).
model OfflineSeries {
  id          String   @id @default(cuid())
  outletId    String
  deviceId    String
  /// "A1" … "Z9": appended to the outlet prefix, e.g. INV + A1 → INVA1-2026-00007
  code        String
  /// { "2026": 41 } — last number used per financial year
  lastSeqByFy Json     @default("{}")
  createdAt   DateTime @default(now())

  @@unique([outletId, deviceId])
  @@unique([outletId, code])
}

/// A business's own role (Phase 4.2): a named subset of a built-in base role's permissions.
/// It can only remove permissions — effective = permissions ∩ base role ∩ modules.
model CustomRole {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  baseRole    Role
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  users    User[]

  @@unique([businessId, name])
}

/// Phase 5 (CANTEEN): a meal service window at an outlet, e.g. Breakfast 07:30–10:00.
/// Used by slot menus and prices, next-day pre-orders, subscriptions, subsidies and quotas.
model MealSlot {
  id             String             @id @default(cuid())
  outletId       String
  name           String
  /// "HH:MM" in outlet time
  startTime      String
  endTime        String
  /// Pre-orders for a day close at this time on the previous day ("HH:MM"); null = no pre-orders
  preorderCutoff String?
  active         Boolean            @default(true)
  sortOrder      Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  outlet         Outlet             @relation(fields: [outletId], references: [id], onDelete: Cascade)
  items          MealSlotItem[]
  subscriptions  MealSubscription[]

  @@index([outletId])
}

// ---------- Phase 5.1 / 5.2 (CANTEEN): corporate accounts, subsidies, wallets, meal tokens ----------

enum BillingCycle {
  MONTHLY
  WEEKLY
}

enum SubsidyType {
  /// Employer pays a % of the meal
  PERCENT
  /// Employer pays a flat amount per meal
  FLAT
}

/// A company whose employees eat at the canteen; billed for its share of their meals.
model CorporateAccount {
  id             String                 @id @default(cuid())
  businessId     String
  name           String
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  gstin          String?
  billingCycle   BillingCycle           @default(MONTHLY)
  /// Max unpaid employer share, paise; 0 = no limit
  creditLimit    Int                    @default(0)
  /// Max meals per member per day (all slots); null = no limit
  dailyMealLimit Int?
  active         Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  members        Customer[]
  rules          CorporateSubsidyRule[]
  statements     CorporateStatement[]

  @@unique([businessId, name])
}

/// Employer subsidy for a corporate account, for one meal slot or (mealSlotId null) every slot.
model CorporateSubsidyRule {
  id                 String           @id @default(cuid())
  corporateAccountId String
  mealSlotId         String?
  type               SubsidyType
  /// PERCENT: 0–100; FLAT: paise per meal
  value              Int
  /// Employer pays at most this per meal, paise
  maxPerMeal         Int?
  /// Employer pays at most this per member per day, paise
  maxPerDay          Int?
  /// Max meals per member per day in this rule's slot; null = no limit
  slotMealLimit      Int?
  active             Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  account            CorporateAccount @relation(fields: [corporateAccountId], references: [id], onDelete: Cascade)

  @@index([corporateAccountId])
}

enum CorporateStatementStatus {
  INVOICED
  PAID
}

/// A period's employer share, invoiced to the company (status record; totals frozen when raised).
model CorporateStatement {
  id                 String                   @id @default(cuid())
  businessId         String
  corporateAccountId String
  /// YYYY-MM-DD, inclusive
  periodFrom         String
  periodTo           String
  meals              Int
  amount             Int
  status             CorporateStatementStatus @default(INVOICED)
  invoiceRef         String?
  note               String?
  createdById        String
  createdAt          DateTime                 @default(now())
  paidAt             DateTime?
  account            CorporateAccount         @relation(fields: [corporateAccountId], references: [id], onDelete: Cascade)

  @@index([corporateAccountId, periodFrom])
}

enum WalletTxnType {
  TOPUP
  SPEND
  REFUND
  ADJUST
}

/// Member wallet ledger. Balance moves only through these rows (compare-and-set on Customer.walletBalance).
model WalletTxn {
  id          String        @id @default(cuid())
  customerId  String
  outletId    String?
  type        WalletTxnType
  /// Signed: + adds to the balance, − spends
  amount      Int
  /// TOPUP: how it was paid (CASH / UPI / CARD)
  mode        String?
  orderId     String?
  note        String?
  createdById String?
  createdAt   DateTime      @default(now())
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([outletId, createdAt])
  @@index([orderId])
}

/// A member's prepaid meal tokens for one slot (or any slot when mealSlotId is null).
model MealTokenAccount {
  id         String         @id @default(cuid())
  customerId String
  mealSlotId String?
  /// Tokens left
  balance    Int            @default(0)
  /// Value of the tokens left, paise (what was paid for them)
  value      Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  txns       MealTokenTxn[]

  @@index([customerId])
}

enum MealTokenTxnType {
  PURCHASE
  REDEEM
  RESTORE
  ADJUST
}

model MealTokenTxn {
  id          String           @id @default(cuid())
  accountId   String
  customerId  String
  outletId    String?
  type        MealTokenTxnType
  /// Signed token count
  count       Int
  /// Signed value, paise
  amount      Int
  /// PURCHASE: how it was paid (CASH / UPI / CARD)
  mode        String?
  orderId     String?
  note        String?
  createdById String?
  createdAt   DateTime         @default(now())
  account     MealTokenAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([outletId, createdAt])
  @@index([orderId])
}

/// Phase 5.3 (CANTEEN): the slot's menu. Items on no slot stay available all day; items on
/// some slots sell only during those slots. `price` overrides the item's price in this slot.
model MealSlotItem {
  id         String   @id @default(cuid())
  slotId     String
  menuItemId String
  /// Paise; null = the item's normal price
  price      Int?
  createdAt  DateTime @default(now())
  slot       MealSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([slotId, menuItemId])
  @@index([menuItemId])
}

enum MealSubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

/// Phase 5.4 (CANTEEN): a customer's prepaid meal plan (one meal, one slot, chosen weekdays).
/// Paid upfront by a normal bill (`orderId`); each day's meal becomes a zero-value pre-order.
model MealSubscription {
  id            String                 @id @default(cuid())
  outletId      String
  customerId    String
  slotId        String
  menuItemId    String
  /// 0 = Monday … 6 = Sunday
  daysOfWeek    Int[]
  /// Outlet-local dates, YYYY-MM-DD (inclusive)
  startDate     String
  endDate       String
  /// Paise per meal (menu-style price: tax-inclusive or not as the outlet bills)
  pricePerMeal  Int
  /// Meals paid for on the upfront bill
  mealCount     Int
  status        MealSubscriptionStatus @default(ACTIVE)
  /// The upfront (paid) bill
  orderId       String?                @unique
  /// Credit note issued on cancellation
  creditNoteId  String?
  refundedMeals Int                    @default(0)
  notes         String?
  createdById   String
  cancelledAt   DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  slot          MealSlot               @relation(fields: [slotId], references: [id], onDelete: Restrict)
  menuItem      MenuItem               @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  skips         MealSubscriptionSkip[]
  meals         MealSubscriptionMeal[]

  @@index([outletId, status])
  @@index([customerId])
}

model MealSubscriptionSkip {
  id             String           @id @default(cuid())
  subscriptionId String
  /// YYYY-MM-DD
  date           String
  createdAt      DateTime         @default(now())
  subscription   MealSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, date])
}

/// One materialised subscription meal: the zero-value pre-order the kitchen cooks for `date`.
model MealSubscriptionMeal {
  id             String           @id @default(cuid())
  subscriptionId String
  /// YYYY-MM-DD
  date           String
  orderId        String           @unique
  createdAt      DateTime         @default(now())
  subscription   MealSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, date])
}

/// Phase 6.3/6.4: an order a customer placed from a QR code or the online page. QR orders hold
/// their items here until staff accept them (then they go onto the table's running tab with KOTs);
/// online orders are bills already (orderId) whose KOTs wait for acceptance when confirmation is on.
model ChannelRequest {
  id            String    @id @default(cuid())
  outletId      String
  /// QR | ONLINE
  channel       String
  /// PENDING | ACCEPTED | REJECTED
  status        String    @default("PENDING")
  tableId       String?
  sessionId     String?
  orderId       String?   @unique
  /// [{ menuItemId, variantId, addonIds, quantity, notes, name, unitPrice }]
  items         Json
  /// KOTs fired for this request (QR: on the running tab; online: on the bill)
  kotIds        String[]
  customerName  String?
  customerPhone String?
  notes         String?
  /// Item total estimate (online: the bill total), paise
  total         Int       @default(0)
  /// Unguessable id the customer uses to follow the order
  publicToken   String    @unique
  /// COUNTER | COD | UPI (online orders)
  payment       String?
  ip            String?
  rejectReason  String?
  decidedById   String?
  decidedAt     DateTime?
  /// Automatic UPI refund after a Razorpay-paid online order was rejected / cancelled:
  /// PROCESSED | PENDING (gateway still processing) | MANUAL (do it in the Razorpay dashboard) | FAILED
  refundStatus  String?
  /// Razorpay refund id(s), comma separated
  refundRef     String?
  /// Refunded to the customer's UPI, paise
  refundAmount  Int?
  /// Credit note issued for the refund (paid bills)
  creditNoteId  String?
  refundError   String?
  createdAt     DateTime  @default(now())
  outlet        Outlet    @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([outletId, status, createdAt])
  @@index([tableId, createdAt])
}

// ---------- Phase 6.1: online channels (aggregators through a partner hub) ----------

/// An outlet's link to an order hub (UrbanPiper-style) that relays Zomato / Swiggy / other orders.
model ChannelConnection {
  id               String    @id @default(cuid())
  outletId         String
  /// Adapter: "HUB" (generic partner hub, see docs/build/channels-hub-contract.md) or "URBANPIPER". One connection per outlet.
  provider         String    @default("HUB")
  enabled          Boolean   @default(false)
  /// Taking orders on the channels right now (pushed to the hub)
  storeOpen        Boolean   @default(false)
  baseUrl          String
  /// This outlet's store id at the hub
  externalStoreId  String
  /// Encrypted (AES-256-GCM, DATA_ENCRYPTION_KEY)
  apiKeyEnc        String?
  webhookSecretEnc String?
  /// Commission % per source channel, e.g. { "ZOMATO": 25, "SWIGGY": 22 } (estimate for reports)
  commission       Json      @default("{}")
  lastMenuSyncAt   DateTime?
  lastError        String?
  lastErrorAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  outlet           Outlet    @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([outletId, provider])
}

/// Phase 6: packing and handover of an online-channel order (Online orders board).
/// Stage NEW / PREPARING / CANCELLED is derived from the bill and its KOTs; this row records
/// what staff did: packed, handed to the rider (or, for orders we deliver, to our partner).
model OrderHandover {
  id             String    @id @default(cuid())
  outletId       String
  orderId        String    @unique
  packedAt       DateTime?
  packedById     String?
  handedOverAt   DateTime?
  handedOverById String?
  /// Rider name typed by staff, or from the channel's rider update
  riderName      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  outlet         Outlet    @relation(fields: [outletId], references: [id], onDelete: Cascade)
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([outletId, createdAt])
}

/// External item id a channel uses for a menu item (default: the menu item id itself).
model ChannelItemMap {
  id         String @id @default(cuid())
  outletId   String
  menuItemId String
  externalId String
  outlet     Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([outletId, menuItemId])
  @@unique([outletId, externalId])
}

/// Every order a channel sent us (accepted or rejected), with their payload and totals for reconciliation.
model ChannelOrder {
  id                String    @id @default(cuid())
  outletId          String
  connectionId      String
  /// ZOMATO / SWIGGY / OTHER … (ORDER_CHANNELS)
  sourceChannel     String
  channelOrderId    String
  /// Our bill (null when rejected)
  orderId           String?
  /// ACCEPTED | REJECTED | CANCELLED
  status            String
  /// Last status we told the channel (ACCEPTED, FOOD_READY, DISPATCHED, DELIVERED, CANCELLED)
  pushedStatus      String?
  pushError         String?
  /// Rider updates from the channel: ASSIGNED, AT_STORE, PICKED_UP, DELIVERED
  riderStatus       String?
  /// { name?, phone?, pickupCode?, eta? } — merged across rider updates
  rider             Json?
  /// FOOD_READY was queued for the channel (packed, or every KOT ready) — it is sent once
  foodReadyQueuedAt DateTime?
  /// What the channel says the customer paid, paise
  channelTotal      Int       @default(0)
  /// Our bill's grand total, paise (menu prices + our GST)
  ourTotal          Int       @default(0)
  /// channelTotal and ourTotal differ by more than ₹1
  mismatch          Boolean   @default(false)
  error             String?
  payload           Json
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  outlet            Outlet    @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([outletId, sourceChannel, channelOrderId])
  @@index([outletId, createdAt])
  @@index([orderId])
}

/// One-time code a customer of the online ordering page uses to prove their phone (Phase 6 follow-up).
/// Separate from OtpCode, so a customer's code can never log anyone in to the staff app.
model CustomerOtp {
  id        String   @id @default(cuid())
  outletId  String
  phone     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  consumed  Boolean  @default(false)
  ip        String?
  createdAt DateTime @default(now())
  outlet    Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([outletId, phone, createdAt])
}
