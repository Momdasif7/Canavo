# Base URL of the CANAVO API (apps/api), WITHOUT a trailing slash.
#
# A phone or emulator cannot reach "localhost" on your computer:
#   - Physical device (Expo Go / dev build): use your computer's LAN IP, e.g.
#     http://192.168.1.23:4000  (macOS: `ipconfig getifaddr en0`,
#     Windows: `ipconfig`, Linux: `hostname -I`). Phone and computer must be on
#     the same Wi-Fi, and the firewall must allow port 4000.
#   - Android emulator: http://10.0.2.2:4000
#   - iOS simulator: http://localhost:4000
# Also add the app's origin to the API's CORS_ORIGINS only if you run the web
# build; native apps are not subject to CORS.
#   - Shared through a single-port gateway / ngrok (API under /api):
#     EXPO_PUBLIC_API_URL=https://<your-ngrok-domain>/api
#     REST calls use this base as-is; the live socket connects to the origin
#     (https://<your-ngrok-domain>) on the default /socket.io path.
EXPO_PUBLIC_API_URL=http://192.168.x.x:4000
