# Vercel → Project → Settings → Environment Variables (Production + Preview)
# Public URL of the CANAVO API on Render (no trailing slash). Baked in at build time.
NEXT_PUBLIC_API_URL=https://canavo-api.onrender.com
# Web session storage: "auto" (default) uses httpOnly cookies when the browser shares cookies with the API
# (app.example.in + api.example.in with AUTH_COOKIE_DOMAIN on the API), otherwise localStorage.
# "storage" forces the old behaviour; "cookie" forces cookies.
NEXT_PUBLIC_SESSION_MODE=auto
